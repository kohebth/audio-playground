{
  "schema": "apg.project.package.v1",
  "version": 1,
  "manifest": {
    "id": "304769de-e65c-4848-9369-db1c96c4eb0c",
    "name": "Guitar PedalBoard",
    "description": "An eight-effect guitar signal chain.",
    "createdAt": "2026-07-23T18:09:56.820Z",
    "updatedAt": "2026-07-27T18:50:42.522Z",
    "lastMode": "simple"
  },
  "workspace": {
    "schema": "apg.ui.workspace.v2",
    "version": 2,
    "entryProject": "test/fixtures/projects-v2/guitar-pedalboard.project.v2.yaml",
    "files": [
      {
        "path": "test/fixtures/projects-v2/guitar-pedalboard.project.v2.yaml",
        "role": "project",
        "content": "kind: apg.project\nschema: apg.project.v2\nname: guitar-pedalboard\nversion: 2.1.0\nunits:\n  - id: noise_gate_unit\n    file: ../units-v2/noise_gate.unit.v2.yaml\n  - id: phaser_unit\n    file: ../units-v2/phaser.unit.v2.yaml\n  - id: overdrive_unit\n    file: ../units-v2/overdrive.unit.v2.yaml\n  - id: tone_stack_unit\n    file: ../units-v2/tone_stack.unit.v2.yaml\n  - id: tremolo_unit\n    file: ../units-v2/tremolo.unit.v2.yaml\n  - id: chorus_unit\n    file: ../units-v2/chorus.unit.v2.yaml\n  - id: delay_unit\n    file: ../units-v2/delay.unit.v2.yaml\n  - id: reverb_unit\n    file: ../units-v2/schroeder_reverb.unit.v2.yaml\nchain:\n  nodes:\n    - id: gate1\n      unit: noise_gate_unit\n      params:\n        threshold: 0.15\n        attack: 0.005\n        release: 0.15\n    - id: drive1\n      unit: overdrive_unit\n      params:\n        drive: 2.4\n        tone: 0.72\n        level: 0.82\n    - id: tone1\n      unit: tone_stack_unit\n      params:\n        gain: 1.3\n        bass: 0.65\n        mid: 0.45\n        treble: 0.72\n        presence: 0.22\n        volume: 0.68\n    - id: trem1\n      unit: tremolo_unit\n      params:\n        rate: 2.4\n        depth: 0.42\n    - id: chorus1\n      unit: chorus_unit\n      params:\n        rate: 0.8105\n        depth: 300\n        mix: 0.24\n    - id: delay1\n      unit: delay_unit\n      params:\n        time_samples: 12000\n        feedback: 0.35\n        mix: 0.3\n    - id: reverb1\n      unit: reverb_unit\n      params:\n        decay: 0.48\n        mix: 0.17\n    - id: phaser\n      unit: phaser_unit\n      params:\n        rate: \"0.5\"\n        depth: \"0.7\"\n        center: \"900\"\n        feedback: \"0.2\"\n        mix: \"0.5\"\n  routes:\n    - from: system.input\n      to: gate1.input\n    - from: drive1.output\n      to: tone1.input\n    - from: trem1.output\n      to: chorus1.input\n    - from: chorus1.output\n      to: delay1.input\n    - from: delay1.output\n      to: reverb1.input\n    - from: gate1.output\n      to: phaser.input\n    - from: phaser.output\n      to: drive1.input\n    - from: reverb1.output\n      to: system.output\n    - from: tone1.output\n      to: trem1.input\nscenes:\n  - name: Clean\n    params:\n      gate1.threshold: 0.12\n      gate1.attack: 0.008\n      gate1.release: 0.25\n      drive1.drive: 1.4\n      drive1.level: 0.75\n      tone1.gain: 0.9\n      tone1.bass: 0.75\n      tone1.mid: 0.3\n      tone1.treble: 0.65\n      tone1.presence: 0.15\n      tone1.volume: 0.72\n      chorus1.rate: 0.65\n      chorus1.depth: 320\n      chorus1.mix: 0.2\n      delay1.time_samples: 14400\n      delay1.feedback: 0.25\n      delay1.mix: 0.15\n  - name: Lead\n    params:\n      gate1.threshold: 0.18\n      gate1.attack: 0.003\n      gate1.release: 0.12\n      drive1.drive: 4.5\n      drive1.level: 0.9\n      tone1.gain: 2.2\n      tone1.bass: 0.55\n      tone1.mid: 0.65\n      tone1.treble: 0.78\n      tone1.presence: 0.4\n      tone1.volume: 0.75\n      chorus1.rate: 1.1\n      chorus1.depth: 480\n      chorus1.mix: 0.3\n      delay1.time_samples: 16800\n      delay1.feedback: 0.48\n      delay1.mix: 0.4\n      reverb1.decay: 0.82\n      reverb1.mix: 0.28\ntargets:\n  default: desktop_full\n  export:\n    - wasm_realtime\n    - offline_render\n"
      },
      {
        "path": "test/fixtures/units-v2/noise_gate.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: noise_gate\nversion: 2.1.0\n\nmeta:\n  title: Noise Gate\n  category: dynamics\n  description: Uses full-wave level detection and adjustable attack and release to suppress low-level noise without hard switching.\n\nparams:\n  threshold:\n    type: float\n    default: 0.2\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 5\n    ui:\n      label: Threshold\n      control: knob\n      unit: x\n      scale: linear\n      display_precision: 2\n  attack:\n    type: float\n    default: 0.005\n    min: 0.0001\n    max: 0.1\n    smoothing_ms: 5\n    ui:\n      label: Attack\n      control: knob\n      unit: s\n      scale: log\n      display_precision: 4\n  release:\n    type: float\n    default: 0.15\n    min: 0.01\n    max: 1.0\n    smoothing_ms: 5\n    ui:\n      label: Release\n      control: knob\n      unit: s\n      scale: log\n      display_precision: 3\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - detected_envelope\n    - gate_trigger\n    - gate_gain\n    - output\n\n  nodes:\n    - id: envelope_detector\n      atom: detect_envelope\n      in:\n        signal: input\n      out:\n        envelope: detected_envelope\n      config:\n        attack: 0.0001\n        release: 0.02\n\n    - id: threshold_detect\n      atom: detect_threshold\n      in:\n        signal: detected_envelope\n      out:\n        gate: gate_trigger\n      config:\n        threshold: ${params.threshold}\n\n    - id: gate_smoothing\n      atom: amplitude_smooth\n      in:\n        signal: gate_trigger\n      out:\n        signal: gate_gain\n      config:\n        attack: ${params.attack}\n        release: ${params.release}\n\n    - id: apply_gate\n      atom: amplitude_multiply\n      in:\n        signal_a: input\n        signal_b: gate_gain\n      out:\n        signal: output\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: true\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/phaser.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: phaser\nversion: 2.0.0\n\nmeta:\n  title: Phaser\n  category: modulation\n  description: Sweeps six first-order all-pass stages to create resonant moving notches.\n\nparams:\n  rate:\n    type: float\n    default: 0.5\n    min: 0.05\n    max: 5.0\n    smoothing_ms: 10\n    ui:\n      label: Rate\n      control: knob\n      unit: Hz\n      scale: log\n      display_precision: 2\n  depth:\n    type: float\n    default: 0.7\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Depth\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n  center:\n    type: float\n    default: 900.0\n    min: 100.0\n    max: 4000.0\n    smoothing_ms: 10\n    ui:\n      label: Center\n      control: knob\n      unit: Hz\n      scale: log\n      display_precision: 0\n  feedback:\n    type: float\n    default: 0.2\n    min: -0.85\n    max: 0.85\n    smoothing_ms: 10\n    ui:\n      label: Resonance\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n  mix:\n    type: float\n    default: 0.5\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Mix\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - lfo\n    - wet\n    - output\n\n  nodes:\n    - id: lfo\n      atom: generation_lfo\n      out:\n        signal: lfo\n      config:\n        frequency: ${params.rate}\n        waveform: 0\n        phase_offset: 0.0\n\n    - id: allpass_sweep\n      atom: modulation_phaser\n      in:\n        signal: input\n        modulator: lfo\n      out:\n        signal: wet\n      config:\n        center_frequency: ${params.center}\n        depth: ${params.depth}\n        feedback: ${params.feedback}\n\n    - id: blend\n      atom: mix_wet_dry\n      in:\n        dry: input\n        wet: wet\n      out:\n        signal: output\n      config:\n        mix: ${params.mix}\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: true\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/overdrive.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: overdrive\nversion: 2.0.0\n\nmeta:\n  title: Overdrive\n  category: drive\n  description: Boosts mono guitar input, soft clips it, shapes tone, and applies output level.\n\nparams:\n  drive:\n    type: float\n    default: 2.0\n    min: 1.0\n    max: 8.0\n    smoothing_ms: 5\n    ui:\n      label: Drive\n      control: knob\n      unit: x\n      scale: linear\n      display_precision: 2\n  tone:\n    type: float\n    default: 0.85\n    min: 0.2\n    max: 1.2\n    smoothing_ms: 5\n    ui:\n      label: Tone\n      control: knob\n      scale: linear\n      display_precision: 2\n  level:\n    type: float\n    default: 0.8\n    min: 0.0\n    max: 2.0\n    smoothing_ms: 5\n    ui:\n      label: Level\n      control: knob\n      unit: x\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - drive_value\n    - driven\n    - clipped\n    - toned\n    - level_value\n    - output\n\n  nodes:\n    - id: drive_value\n      atom: generation_dc\n      out:\n        signal: drive_value\n      config:\n        value: ${params.drive}\n\n    - id: apply_drive\n      atom: amplitude_multiply\n      in:\n        signal_a: input\n        signal_b: drive_value\n      out:\n        signal: driven\n\n    - id: clip_drive\n      atom: amplitude_clip_soft\n      in:\n        signal: driven\n      out:\n        signal: clipped\n      config:\n        threshold: 0.85\n        curve: 0\n\n    - id: tone_filter\n      atom: filter_biquad_coefficients\n      in:\n        signal: clipped\n      out:\n        signal: toned\n      config:\n        b0: ${params.tone}\n        b1: 0.0\n        b2: 0.0\n        a1: 0.0\n        a2: 0.0\n\n    - id: level_value\n      atom: generation_dc\n      out:\n        signal: level_value\n      config:\n        value: ${params.level}\n\n    - id: apply_level\n      atom: amplitude_multiply\n      in:\n        signal_a: toned\n        signal_b: level_value\n      out:\n        signal: output\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: true\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/tone_stack.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: tone_stack\nversion: 2.1.0\n\nmeta:\n  title: Plexi Tone Stage\n  category: amp\n  description: Adds Plexi-inspired preamp and power saturation, interactive tone filters, presence, cabinet roll-off, and master volume.\n\nparams:\n  gain:\n    type: float\n    default: 1.8\n    min: 0.75\n    max: 4.0\n    smoothing_ms: 10\n    ui:\n      label: Preamp Gain\n      control: knob\n      unit: x\n      scale: linear\n      display_precision: 2\n  bass:\n    type: float\n    default: 0.6\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Bass\n      control: knob\n      scale: linear\n      display_precision: 2\n  mid:\n    type: float\n    default: 0.35\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Middle\n      control: knob\n      scale: linear\n      display_precision: 2\n  treble:\n    type: float\n    default: 0.7\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Treble\n      control: knob\n      scale: linear\n      display_precision: 2\n  presence:\n    type: float\n    default: 0.2\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Presence\n      control: knob\n      scale: linear\n      display_precision: 2\n  volume:\n    type: float\n    default: 0.65\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Master Volume\n      control: knob\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - input_tight\n    - gain_value\n    - preamp_hot\n    - preamp_clipped\n    - bass_cut\n    - bass_shaped\n    - mid_band\n    - mid_value\n    - mid_shaped\n    - mid_mix\n    - treble_dark\n    - tone_shaped\n    - volume_value\n    - power_drive\n    - power_clipped\n    - presence_band\n    - presence_value\n    - presence_shaped\n    - plexi_mix\n    - cabinet_shaped\n    - output\n\n  nodes:\n    - id: input_highpass\n      atom: filter_biquad\n      in:\n        signal: input\n      out:\n        signal: input_tight\n      config:\n        cutoff: 75.0\n        q: 0.707\n        mode: 1\n        smoothing_ms: 10.0\n\n    - id: gain_value\n      atom: generation_dc\n      out:\n        signal: gain_value\n      config:\n        value: ${params.gain}\n\n    - id: apply_preamp_gain\n      atom: amplitude_multiply\n      in:\n        signal_a: input_tight\n        signal_b: gain_value\n      out:\n        signal: preamp_hot\n\n    - id: preamp_saturation\n      atom: amplitude_clip_soft\n      in:\n        signal: preamp_hot\n      out:\n        signal: preamp_clipped\n      config:\n        threshold: 0.72\n        curve: 1\n\n    - id: bass_cut_highpass\n      atom: filter_biquad\n      in:\n        signal: preamp_clipped\n      out:\n        signal: bass_cut\n      config:\n        cutoff: 219.0\n        q: 0.707\n        mode: 1\n        smoothing_ms: 10.0\n\n    - id: bass_control\n      atom: mix_crossfade\n      in:\n        signal_a: bass_cut\n        signal_b: preamp_clipped\n      out:\n        signal: bass_shaped\n      config:\n        t: ${params.bass}\n        curve: 0\n\n    - id: mid_bandpass\n      atom: filter_biquad\n      in:\n        signal: bass_shaped\n      out:\n        signal: mid_band\n      config:\n        cutoff: 700.0\n        q: 0.707\n        mode: 2\n        smoothing_ms: 10.0\n\n    - id: mid_value\n      atom: generation_dc\n      out:\n        signal: mid_value\n      config:\n        value: ${params.mid}\n\n    - id: apply_mid\n      atom: amplitude_multiply\n      in:\n        signal_a: mid_band\n        signal_b: mid_value\n      out:\n        signal: mid_shaped\n\n    - id: mix_mid\n      atom: amplitude_add\n      in:\n        signal_a: bass_shaped\n        signal_b: mid_shaped\n      out:\n        signal: mid_mix\n\n    - id: treble_lowpass\n      atom: filter_biquad\n      in:\n        signal: mid_mix\n      out:\n        signal: treble_dark\n      config:\n        cutoff: 1400.0\n        q: 0.707\n        mode: 0\n        smoothing_ms: 10.0\n\n    - id: treble_control\n      atom: mix_crossfade\n      in:\n        signal_a: treble_dark\n        signal_b: mid_mix\n      out:\n        signal: tone_shaped\n      config:\n        t: ${params.treble}\n        curve: 0\n\n    - id: volume_value\n      atom: generation_dc\n      out:\n        signal: volume_value\n      config:\n        value: ${params.volume}\n\n    - id: apply_master_volume\n      atom: amplitude_multiply\n      in:\n        signal_a: tone_shaped\n        signal_b: volume_value\n      out:\n        signal: power_drive\n\n    - id: power_saturation\n      atom: amplitude_clip_soft\n      in:\n        signal: power_drive\n      out:\n        signal: power_clipped\n      config:\n        threshold: 0.9\n        curve: 1\n\n    - id: presence_highpass\n      atom: filter_biquad\n      in:\n        signal: power_clipped\n      out:\n        signal: presence_band\n      config:\n        cutoff: 2800.0\n        q: 0.707\n        mode: 1\n        smoothing_ms: 10.0\n\n    - id: presence_value\n      atom: generation_dc\n      out:\n        signal: presence_value\n      config:\n        value: ${params.presence}\n\n    - id: apply_presence\n      atom: amplitude_multiply\n      in:\n        signal_a: presence_band\n        signal_b: presence_value\n      out:\n        signal: presence_shaped\n\n    - id: mix_presence\n      atom: amplitude_add\n      in:\n        signal_a: power_clipped\n        signal_b: presence_shaped\n      out:\n        signal: plexi_mix\n\n    - id: cabinet_rolloff\n      atom: filter_biquad\n      in:\n        signal: plexi_mix\n      out:\n        signal: cabinet_shaped\n      config:\n        cutoff: 5000.0\n        q: 0.707\n        mode: 0\n        smoothing_ms: 10.0\n\n    - id: output_limiter\n      atom: amplitude_clip_hard\n      in:\n        signal: cabinet_shaped\n      out:\n        signal: output\n      config:\n        threshold: 0.98\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: false\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/tremolo.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: tremolo\nversion: 2.0.0\n\nmeta:\n  title: Tremolo\n  category: modulation\n  description: Uses an LFO to modulate mono signal amplitude.\n\nparams:\n  rate:\n    type: float\n    default: 5.0\n    min: 0.1\n    max: 12.0\n    smoothing_ms: 10\n    ui:\n      label: Rate\n      control: knob\n      unit: Hz\n      scale: linear\n      display_precision: 2\n  depth:\n    type: float\n    default: 0.4\n    min: 0.0\n    max: 0.9\n    smoothing_ms: 10\n    ui:\n      label: Depth\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - lfo\n    - output\n\n  nodes:\n    - id: lfo\n      atom: generation_lfo\n      out:\n        signal: lfo\n      config:\n        frequency: ${params.rate}\n        waveform: 0\n        phase_offset: 0.0\n\n    - id: apply_tremolo\n      atom: modulation_amplitude\n      in:\n        signal: input\n        modulator: lfo\n      out:\n        signal: output\n      config:\n        depth: ${params.depth}\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: true\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/chorus.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: chorus\nversion: 2.0.0\n\nmeta:\n  title: Chorus\n  category: modulation\n  description: Thickens mono input with an LFO-modulated short delay and an internal wet/dry blend.\n\nparams:\n  rate:\n    type: float\n    default: 0.8\n    min: 0.1\n    max: 5.0\n    smoothing_ms: 10\n    ui:\n      label: Rate\n      control: knob\n      unit: Hz\n      scale: log\n      display_precision: 2\n  depth:\n    type: float\n    default: 384.0\n    min: 48.0\n    max: 960.0\n    smoothing_ms: 10\n    ui:\n      label: Depth\n      control: knob\n      unit: samples\n      scale: linear\n      display_precision: 0\n  mix:\n    type: float\n    default: 0.35\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Mix\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - lfo\n    - wet\n    - output\n\n  nodes:\n    - id: lfo\n      atom: generation_lfo\n      out:\n        signal: lfo\n      config:\n        frequency: ${params.rate}\n        waveform: 0\n        phase_offset: 0.0\n\n    - id: modulated_delay\n      atom: modulation_phase\n      in:\n        signal: input\n        modulator: lfo\n      out:\n        signal: wet\n      config:\n        depth: ${params.depth}\n\n    - id: blend\n      atom: mix_wet_dry\n      in:\n        dry: input\n        wet: wet\n      out:\n        signal: output\n      config:\n        mix: ${params.mix}\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: false\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/delay.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: delay\nversion: 2.1.0\n\nmeta:\n  title: Delay\n  category: delay\n  description: Produces a repeating mono echo train with feedback and an internal wet/dry blend.\n\nparams:\n  time_samples:\n    type: int\n    default: 12000\n    min: 1\n    max: 47999\n    ui:\n      label: Time\n      control: slider\n      unit: samples\n      scale: linear\n      display_precision: 0\n  feedback:\n    type: float\n    default: 0.35\n    min: 0.0\n    max: 0.9\n    smoothing_ms: 10\n    ui:\n      label: Feedback\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n  mix:\n    type: float\n    default: 0.3\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 10\n    ui:\n      label: Mix\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - feedback_train\n    - delayed\n    - output\n\n  nodes:\n    - id: feedback_echoes\n      atom: filter_comb_fb\n      in:\n        signal: input\n      out:\n        signal: feedback_train\n      config:\n        delay_samples: ${params.time_samples}\n        coefficient: ${params.feedback}\n\n    - id: delay_line\n      atom: delay_line\n      in:\n        signal: feedback_train\n      out:\n        signal: delayed\n      config:\n        length: ${params.time_samples}\n\n    - id: blend_delay\n      atom: mix_wet_dry\n      in:\n        dry: input\n        wet: delayed\n      out:\n        signal: output\n      config:\n        mix: ${params.mix}\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: false\n  offline_render: true\n"
      },
      {
        "path": "test/fixtures/units-v2/schroeder_reverb.unit.v2.yaml",
        "role": "unit",
        "content": "kind: apg.unit\nschema: apg.unit.v2\nname: schroeder_reverb\nversion: 2.0.0\n\nmeta:\n  title: Schroeder Reverb\n  category: reverb\n  description: Builds a mono reverb tail from four feedback combs, two allpass diffusers, and a wet/dry blend.\n\nparams:\n  decay:\n    type: float\n    default: 0.72\n    min: 0.1\n    max: 0.95\n    smoothing_ms: 20\n    ui:\n      label: Decay\n      control: knob\n      unit: x\n      scale: linear\n      display_precision: 2\n  mix:\n    type: float\n    default: 0.22\n    min: 0.0\n    max: 1.0\n    smoothing_ms: 20\n    ui:\n      label: Mix\n      control: knob\n      unit: \"%\"\n      scale: linear\n      display_precision: 2\n\nports:\n  inputs:\n    - name: input\n      type: audio\n      channels: 1\n  outputs:\n    - name: output\n      type: audio\n      channels: 1\n\ngraph:\n  signals:\n    - input\n    - comb_a\n    - comb_b\n    - comb_c\n    - comb_d\n    - comb_ab\n    - comb_cd\n    - comb_mix\n    - diffuse_a\n    - diffuse_b\n    - output\n\n  nodes:\n    - id: comb_a\n      atom: filter_comb_fb\n      in:\n        signal: input\n      out:\n        signal: comb_a\n      config:\n        delay_samples: 1499\n        coefficient: ${params.decay}\n\n    - id: comb_b\n      atom: filter_comb_fb\n      in:\n        signal: input\n      out:\n        signal: comb_b\n      config:\n        delay_samples: 1777\n        coefficient: ${params.decay}\n\n    - id: comb_c\n      atom: filter_comb_fb\n      in:\n        signal: input\n      out:\n        signal: comb_c\n      config:\n        delay_samples: 1999\n        coefficient: ${params.decay}\n\n    - id: comb_d\n      atom: filter_comb_fb\n      in:\n        signal: input\n      out:\n        signal: comb_d\n      config:\n        delay_samples: 2137\n        coefficient: ${params.decay}\n\n    - id: mix_ab\n      atom: mix_wet_dry\n      in:\n        dry: comb_a\n        wet: comb_b\n      out:\n        signal: comb_ab\n      config:\n        mix: 0.5\n\n    - id: mix_cd\n      atom: mix_wet_dry\n      in:\n        dry: comb_c\n        wet: comb_d\n      out:\n        signal: comb_cd\n      config:\n        mix: 0.5\n\n    - id: mix_combs\n      atom: mix_wet_dry\n      in:\n        dry: comb_ab\n        wet: comb_cd\n      out:\n        signal: comb_mix\n      config:\n        mix: 0.5\n\n    - id: diffuse_a\n      atom: filter_allpass\n      in:\n        signal: comb_mix\n      out:\n        signal: diffuse_a\n      config:\n        delay_samples: 225\n        coefficient: 0.7\n\n    - id: diffuse_b\n      atom: filter_allpass\n      in:\n        signal: diffuse_a\n      out:\n        signal: diffuse_b\n      config:\n        delay_samples: 556\n        coefficient: 0.5\n\n    - id: blend\n      atom: mix_wet_dry\n      in:\n        dry: input\n        wet: diffuse_b\n      out:\n        signal: output\n      config:\n        mix: ${params.mix}\n\ncompatibility:\n  desktop_full: true\n  wasm_realtime: true\n  m7_static: false\n  offline_render: true\n"
      }
    ]
  },
